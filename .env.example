# Copy to .env.local and supply your own values. No real credentials belong here.
# Atlas or another MongoDB replica set; standalone MongoDB is unsupported.
MONGODB_URI=
MONGODB_DB=
# Canonical browser origin, with no path. HTTPS is required in production.
APP_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used only by the explicit administrator bootstrap script; remove afterward.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Leave empty normally. Demo seeding additionally requires NODE_ENV=development.
ALLOW_DEMO_SEED=
# Optional: only a single-IP header overwritten by your trusted reverse proxy.
# Never configure a client-controlled or comma-separated forwarding header.
TRUSTED_CLIENT_IP_HEADER=

